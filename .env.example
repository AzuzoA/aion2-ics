# Next-Auth
NEXTAUTH_URL=http://localhost:3000
# `npx auth secret` 또는 `openssl rand -base64 32` 로 생성
NEXTAUTH_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
# Redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 개발자 전용 페이지 접근 허용 Discord ID (쉼표 구분)
DEV_DISCORD_IDS=

# SQLite 파일 경로 (기본: ./data/app.db)
# DATABASE_PATH=

# Discord 앱 없이 로컬 테스트용 로그인 (production에서는 무시됨)
DEV_LOGIN=false
